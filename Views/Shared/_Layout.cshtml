@inject IHttpContextAccessor HttpContextAccessor

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    bool ehAdmin = User.Identity.IsAuthenticated &&
                   User.Claims.Any(c => c.Type == "EhAdministrador" && c.Value == "true");
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Jujuba - Casa de Doces</title>

    <link rel="icon" type="image/png" href="~/Img/LogoJujuba.png" />

    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
</head>
<body>
    <div id="Cor-Borda">
        <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white px-3">
        
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="~/Img/LogoJujuba.png" alt="Logo Jujuba" style="height:50px;" />
        </a>

        <!-- Botão mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Conteúdo colapsável -->
        <div class="collapse navbar-collapse" id="navbarContent">

            <!-- Links -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="QuemSomos">Quem Somos</a>
                </li>

                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ListaProduto" asp-action="Index">Lista de Produtos</a>
                    </li>
                }

                @if (ehAdmin)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Produto" asp-action="Index">Produtos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Categoria" asp-action="Index">Categorias</a>
                    </li>
                }

            </ul>

            <!-- Usuário -->
            <ul class="navbar-nav">

                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @User.Identity.Name
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Login"
                                   asp-action="Logout">
                                    Sair
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Login" asp-action="Index">Entrar</a>
                    </li>
                }

            </ul>
        </div>
    </nav>
</header>

        <main>
            @RenderBody()
        </main>

        <footer class="cta">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
                <!-- Contato -->
                <div>
                    <strong>📞 (14) 3644-4490</strong>
                </div>

                <!-- Redes sociais -->
                <div class="social-icons">
                    <a href="https://wa.me/+551436444490" target="_blank">
                        <img src="~/Img/LogoWhatssap.png" alt="Logo WhatsApp" class="whatsapp-icon"/>
                    </a>
                    <a href="https://www.instagram.com/casadedocesjujuba" target="_blank">
                        <img src="~/Img/LogoInstagram.png" alt="Logo Instagram" class="instagram-icon"/>
                    </a>
                    <a href="https://www.facebook.com/casadedocesjujub4" target="_blank">
                        <img src="~/Img/facebook-logo.png" alt="Logo Facebook" class="facebook-icon"/>
                    </a>
                </div>

                <!-- Quem somos -->
                <div class="mt-2 mt-md-0">
                    <a href="@Url.Action("QuemSomos", "Home")" class="text-white">Quem Somos</a>
                </div>
            </div>
        </footer>
    </div>

    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)
    </body>
</html>
