@model List<CatalogoDeDoces.Dtos.ProdutoListaDto>
@{
    ViewData["Title"] = "Lista de Produtos";
}

@if (TempData["Mensagem"] != null)
{
    <div class="alert alert-success">@TempData["Mensagem"]</div>
}

<h2 class="mb-4">Minha Lista de Produtos</h2>

@if (Model.Any())
{
    <form asp-action="EnviarOrcamento" asp-controller="ListaProduto" method="post">
        @Html.AntiForgeryToken()

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Imagem</th>
                    <th>Quantidade</th>
                    <th>Nome</th>
                    <th>Preço</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(Model[i].ImagemUrl))
                            {
                                <img src="@Model[i].ImagemUrl" alt="Imagem do Produto" width="100" />
                            }
                            else
                            {
                                <span>Sem imagem</span>
                            }
                        </td>
                        <td>
                            <div class="input-group" style="width: 140px;">
                                <button class="btn btn-outline-secondary" type="button" onclick="alterarQuantidade(this, -1)">-</button>

                                <input type="hidden" name="produtos[@i].ProdutoId" value="@Model[i].ProdutoId" />
                                <input type="number" class="form-control text-center quantidade" 
                                       name="produtos[@i].Quantidade" 
                                       value="@(Model[i].Quantidade > 0 ? Model[i].Quantidade : 1)" 
                                       min="1" />
                                <input type="hidden" name="produtos[@i].Nome" value="@Model[i].Nome" />

                                <button class="btn btn-outline-secondary" type="button" onclick="alterarQuantidade(this, 1)">+</button>
                            </div>
                        </td>
                        <td>@Model[i].Nome</td>
                        <td>R$ @Model[i].Preco.ToString("N2")</td>
                        <td>
                            <button type="submit" 
                                    formaction="@Url.Action("RemoverLista", "ListaProduto")" 
                                    name="id" value="@Model[i].ProdutoId" 
                                    class="btn btn-danger">
                                Remover
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <a asp-action="Index" asp-controller="Catalogo" class="btn btn-primary">Voltar ao Catálogo</a>
        <button type="submit" class="btn btn-success">Solicitar orçamento via WhatsApp</button>
    </form>
}
else
{
    <div class="alert alert-info">Sua lista está vazia.</div>
}

@section Scripts {
    <script src="~/js/AlterarQuantidade.js"></script>
    @if (TempData["AbrirWhatsApp"] != null)
    {
        var mensagem = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["AbrirWhatsApp"].ToString());
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const numeroLoja = '551436444490';
                const mensagem = "@mensagem";
                const url = `https://wa.me/${numeroLoja}?text=${encodeURIComponent(mensagem)}`;
                window.open(url, '_blank');
            });
        </script>
    }
}
